# ──────────────────────────────────────────────────────────────
# SERVER
# ──────────────────────────────────────────────────────────────
PORT=3000
# "development" enables stack traces in error responses. Use "production" when deployed.
NODE_ENV=development

# ──────────────────────────────────────────────────────────────
# DATABASE
# MongoDB MUST be a replica set (or Atlas) — multi-document
# transactions used for wallet transfers require it.
# Local replica set example: mongodb://127.0.0.1:27017/mini_wallet?replicaSet=rs0
# ──────────────────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/mini_wallet?replicaSet=rs0

# ──────────────────────────────────────────────────────────────
# JWT
# Generate strong secrets, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ──────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_different_long_random_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ──────────────────────────────────────────────────────────────
# SAFARICOM DARAJA API
# Get these from https://developer.safaricom.co.ke (create an app)
# Sandbox base URL: https://sandbox.safaricom.co.ke
# Production base URL: https://api.safaricom.co.ke
# ──────────────────────────────────────────────────────────────
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret

# Lipa Na M-Pesa Online (STK Push)
MPESA_SHORT_CODE=174379
MPESA_PASSKEY=your_lipa_na_mpesa_online_passkey
# Publicly reachable HTTPS URL Safaricom will POST STK results to.
MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback

# B2C (Business to Customer — withdrawals)
MPESA_B2C_URL=/mpesa/b2c/v1/paymentrequest
MPESA_INITIATOR_NAME=your_b2c_initiator_username
# Security credential = your initiator password encrypted with Safaricom's public cert.
# For sandbox you may paste the pre-generated test credential from the portal.
MPESA_INITIATOR_PASSWORD=your_encrypted_security_credential
MPESA_B2C_RESULT_URL=https://your-domain.com/api/mpesa/b2c/result
MPESA_B2C_QUEUE_URL=https://your-domain.com/api/mpesa/b2c/timeout

# ──────────────────────────────────────────────────────────────
# SECURITY
# ──────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Comma-separated Safaricom source IPs allowed to hit the public callback.
# In development an EMPTY value disables the IP check (the source IP varies in
# sandbox). In production an empty value FAILS CLOSED — callbacks are refused —
# so this MUST be populated when NODE_ENV=production.
SAFARICOM_IP_WHITELIST=196.201.214.200,196.201.214.206,196.201.213.114,196.201.214.207,196.201.214.208,196.201.213.44,196.201.212.127,196.201.212.138,196.201.212.129,196.201.212.136,196.201.212.74,196.201.212.69

# Optional shared secret for the public M-Pesa callbacks (defence in depth).
# When set, register your CallBack/Result URLs with `?token=<this value>` and
# any callback missing/mismatching it is ignored. Leave empty to disable.
# Generate, e.g.: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MPESA_CALLBACK_SECRET=

# ──────────────────────────────────────────────────────────────
# LEDGER & CURRENCY
# ──────────────────────────────────────────────────────────────
# Default currency for clients that do not specify one. Must be present in
# src/core/money/currencies.js AND have limits defined for every KYC tier in
# src/core/limits/tiers.js, or requests in it are refused rather than run
# unlimited.
DEFAULT_CURRENCY=KES

# How often the transactional outbox dispatcher runs, in ms. Safe on every
# instance: events are claimed atomically, so dispatchers never double-deliver.
OUTBOX_INTERVAL_MS=2000

# ──────────────────────────────────────────────────────────────
# M-PESA TARIFFS (least-cost routing)
# ──────────────────────────────────────────────────────────────
# The router compares rails on cost, so these must reflect the tariff you
# actually signed with Safaricom — a wrong number here quietly sends money
# down the wrong rail. JSON array of bands; `upTo` is inclusive, null = no
# ceiling. Omit to use the built-in defaults.
# MPESA_B2C_TARIFF=[{"upTo":100,"charge":"0.00"},{"upTo":1500,"charge":"15.00"},{"upTo":null,"charge":"110.00"}]
# MPESA_C2B_TARIFF=[{"upTo":null,"charge":"0.00"}]
# Per-transaction ceiling Safaricom allows on your short code.
MPESA_MAX_TRANSACTION=250000

# ──────────────────────────────────────────────────────────────
# PESALINK (instant bank transfers, Kenya — IPSL)
# ──────────────────────────────────────────────────────────────
# The rail registers only when all of these are present; without them the
# router simply has one fewer candidate.
PESALINK_BASE_URL=
PESALINK_CLIENT_ID=
PESALINK_CLIENT_SECRET=
PESALINK_SENDER_BANK_CODE=
PESALINK_SENDER_ACCOUNT=
# HMAC-SHA256 key for webhook signatures. Without it, callbacks from this rail
# are refused — an unsigned webhook that credits a wallet is the single most
# valuable thing an attacker could find.
PESALINK_WEBHOOK_SECRET=

# ──────────────────────────────────────────────────────────────
# SACCOs / MICROFINANCE (Apache Fineract)
# ──────────────────────────────────────────────────────────────
# One entry per institution — onboarding a SACCO is configuration, not a
# deploy. `feeBps` is our margin in basis points (100 = 1%).
# SACCO_INSTITUTIONS=[{"institutionId":"stima","displayName":"Stima SACCO","baseUrl":"https://core.example/fineract-provider/api/v1","tenantId":"stima","username":"api_user","password":"...","currency":"KES","feeBps":50}]

# ──────────────────────────────────────────────────────────────
# DEVELOPMENT
# ──────────────────────────────────────────────────────────────
# Registers a simulated rail with controllable latency and failure rate, so
# the wallet runs end to end with no provider credentials. Refused outright
# when NODE_ENV=production — it would settle payouts that never happened.
ENABLE_RAIL_SIMULATOR=false

# ──────────────────────────────────────────────────────────────
# RATE LIMITS
# ──────────────────────────────────────────────────────────────
# All optional — the defaults shown are the production values. Raise them
# where many genuine users share one egress address (a corporate NAT, a CI
# runner); a malformed value falls back to the default rather than disabling
# the limit, since failing open on a brute-force control is the dangerous
# direction.
# RATE_LIMIT_GLOBAL_MAX=100        # per IP / 15 min
# RATE_LIMIT_AUTH_MAX=5            # per IP / 15 min — login and register
# RATE_LIMIT_REFRESH_MAX=30        # per IP / 15 min
# RATE_LIMIT_PAYMENT_MAX=10        # per USER / min
# Matching *_WINDOW_MS variables override the windows.
